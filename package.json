{
  "name": "greenarrow-labs",
  "version": "1.0.0",
  "description": "GreenArrow Labs - Advanced Trading Strategy Suite for backtesting and analysis using TA-Lib indicators and the Backtesting.py library.",
  "type": "module",
  "scripts": {
    "dev": "cd client && vite",
    "build": "cd client && vue-tsc --project tsconfig.json && vite build",
    "preview": "cd client && vite preview",
    "type-check": "cd client && vue-tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix --config .eslintrc.cjs",
    "lint:check": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --config .eslintrc.cjs",
    "clean": "rm -rf public/js public/css public/assets",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mezerotm/backtesting.git"
  },
  "keywords": [
    "backtesting",
    "trading",
    "strategies",
    "financial"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mezerotm/backtesting/issues"
  },
  "homepage": "https://github.com/mezerotm/backtesting#readme",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.4.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "postcss": "^8.5.6",
    "preline": "^2.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.0.8",
    "vue-tsc": "^3.0.5"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vueuse/core": "^13.6.0",
    "ajv": "^8.17.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  }
